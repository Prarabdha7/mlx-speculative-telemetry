# Host/port for the FastAPI dev server (uvicorn app.main:app --host $HOST --port $PORT)
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins for the Next.js frontend
ALLOWED_ORIGINS=http://localhost:3000

# Local path or Hugging Face repo id for the draft (small/fast) and target (large)
# MLX models. Both must share the same tokenizer/vocabulary, since speculative
# decoding verifies draft tokens against the target model at the token-id level.
DRAFT_MODEL=mlx-community/Llama-3.2-1B-Instruct-4bit
TARGET_MODEL=mlx-community/Llama-3.1-8B-Instruct-4bit

# Path to the SQLite file storing persisted benchmark run history (gitignored).
# Relative paths resolve against the working directory uvicorn is started from
# (backend/, per the Local Run Commands).
DB_PATH=./benchmarks.sqlite3
